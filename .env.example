# Source runs: export these variables in the shell (Simra does not automatically load .env).
# Release builds instead use POSTHOG_PROJECT_TOKEN and POSTHOG_HOST (see CONTRIBUTING.md).
# Never use a personal API key.
# Ingestion settings do not imply consent. Analytics also requires explicit opt-in via simra analytics on.
SIMRA_POSTHOG_PROJECT_TOKEN=phc_your_project_token
SIMRA_POSTHOG_HOST=https://your-posthog-host

# Disable all analytics. Also supported: DO_NOT_TRACK=1.
# SIMRA_NO_ANALYTICS=1
