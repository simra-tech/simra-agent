{
  "schema": "simra.technology/0",
  "name": "ihp-sg13",
  "description": "IHP SG13G2 and SG13CMOS5L low-voltage and high-voltage MOS devices (PSP 103, OSDI).",
  "pdks": ["ihp-sg13g2", "ihp-sg13cmos5l"],
  "ngspice": {
    "operating_point": {
      "device_letter": "n",
      "params": { "vgs": "vgs", "vth": "vth", "vds": "vds", "vdsat": "vdss", "id": "ids", "gm": "gm", "gds": "gds" }
    },
    "size_unit_m": 1,
    "size_unit_source": "ihp-sg13g2/libs.tech/ngspice/models/sg13g2_moslv_mod.lib (the subcircuit defaults are w=0.35u l=0.34u; the model files set no .option scale)",
    "mismatch": {
      "ihp-sg13g2": {
        "lib_suffix": "_mismatch",
        "instance_param": "mm_ok=1",
        "devices": [
          "npn13G2",
          "npn13G2_5t",
          "npn13G2l",
          "npn13G2l_5t",
          "npn13G2v",
          "npn13G2v_5t",
          "pnpMPA",
          "rsil",
          "rhigh",
          "rppd",
          "cap_cmim",
          "cap_rfcmim",
          "sg13_lv_nmos",
          "sg13_lv_pmos",
          "sg13_hv_nmos",
          "sg13_hv_pmos",
          "sg13_hv_svaricap"
        ],
        "source": "ihp-sg13g2/libs.tech/ngspice/models/cornerHBT.lib, cornerMOSlv.lib, cornerMOShv.lib, cornerRES.lib, cornerCAP.lib (sections <corner>_mismatch); *_mod_mismatch.lib (each device subcircuit has the parameter mm_ok=0, and agauss(..., (mm_ok != 1 ? 0 : 1)): no mismatch unless the instance sets mm_ok=1)"
      }
    },
    "limits": {
      "ihp-sg13g2": {
        "hbt_cells": [
          "npn13G2",
          "npn13G2_5t",
          "npn13G2l",
          "npn13G2l_5t",
          "npn13G2v",
          "npn13G2v_5t"
        ],
        "classes": {
          "hbt": {
            "kind": "hbt",
            "letter": "q",
            "models": "^npn13g2[lv]?_nx_vbic$",
            "source": "ihp-sg13g2/libs.tech/ngspice/models/sg13g2_hbt_mod.lib (.model npn13G2_NX_vbic, npn13G2l_NX_vbic, npn13G2v_NX_vbic)"
          },
          "mos_lv": {
            "kind": "mos",
            "letter": "n",
            "models": "^sg13g2_lv_[np]mos_psp",
            "source": "ihp-sg13g2/libs.tech/ngspice/models/sg13g2_moslv_parm.lib"
          },
          "mos_hv": {
            "kind": "mos",
            "letter": "n",
            "models": "^sg13g2_hv_[np]mos_psp",
            "source": "ihp-sg13g2/libs.tech/ngspice/models/sg13g2_moshv_parm.lib"
          }
        },
        "limits": [
          {
            "id": "hbt_vce_max",
            "class": "hbt",
            "quantity": "vce",
            "op": "<=",
            "limit": 1.6,
            "models": "^npn13g2l?_nx_vbic$",
            "source": "ihp-sg13g2/libs.tech/ngspice/models/sg13g2_hbt_mod.lib (npn13G2_NX_vbic and npn13G2l_NX_vbic: vce_max = 1.6); ihp-sg13g2/libs.doc/doc/SG13G2_os_process_spec.pdf 3.1, 3.2 (BVCEO target 1.6 V, min 1.4 V)"
          },
          {
            "id": "hbt_v_vce_max",
            "class": "hbt",
            "quantity": "vce",
            "op": "<=",
            "limit": 2.2,
            "models": "^npn13g2v_nx_vbic$",
            "source": "ihp-sg13g2/libs.doc/doc/SG13G2_os_process_spec.pdf 3.3 (NPN13G2V_BVCEO min 2.2 V)"
          },
          {
            "id": "hbt_vcb_max",
            "class": "hbt",
            "quantity": "vcb",
            "op": "<=",
            "limit": 3.8,
            "models": "^npn13g2l?_nx_vbic$",
            "source": "ihp-sg13g2/libs.doc/doc/SG13G2_os_process_spec.pdf 3.1, 3.2 (BVCBO min 3.8 V)"
          },
          {
            "id": "hbt_veb_max",
            "class": "hbt",
            "quantity": "veb",
            "op": "<=",
            "limit": 1.0,
            "source": "ihp-sg13g2/libs.doc/doc/SG13G2_os_process_spec.pdf 3.1 to 3.3 (BVEBO min 1.0 V)"
          },
          {
            "id": "hbt_vbe_max",
            "class": "hbt",
            "quantity": "vbe",
            "op": "<=",
            "limit": 1.6,
            "source": "ihp-sg13g2/libs.tech/ngspice/models/sg13g2_hbt_mod.lib (vbe_max = 1.6)"
          },
          {
            "id": "hbt_ic_per_emitter_max",
            "class": "hbt",
            "quantity": "ic_per_emitter",
            "op": "<=",
            "limit": 0.0035,
            "models": "^npn13g2_nx_vbic$",
            "source": "ihp-sg13g2/libs.doc/doc/SG13G2_os_process_spec.pdf 3.1 (NPN13G2_ICMAX 3.5 mA, AE = 0.07 x 0.9 um2, one emitter)"
          },
          {
            "id": "hbt_l_ic_per_emitter_max",
            "class": "hbt",
            "quantity": "ic_per_emitter",
            "op": "<=",
            "limit": 0.003,
            "models": "^npn13g2l_nx_vbic$",
            "source": "ihp-sg13g2/libs.doc/doc/SG13G2_os_process_spec.pdf 3.2 (NPN13G2L_ICMAX 3.0 mA)"
          },
          {
            "id": "hbt_v_ic_per_emitter_max",
            "class": "hbt",
            "quantity": "ic_per_emitter",
            "op": "<=",
            "limit": 0.0005,
            "models": "^npn13g2v_nx_vbic$",
            "source": "ihp-sg13g2/libs.doc/doc/SG13G2_os_process_spec.pdf 3.3 (NPN13G2V_ICMAX 0.5 mA)"
          },
          {
            "id": "hbt_ib_reverse",
            "class": "hbt",
            "quantity": "ib",
            "op": ">=",
            "limit": 0,
            "assumption": "limit_hbt_ib_reverse",
            "description": "no reverse DC base current (the onset of avalanche multiplication); the PDK gives no limit, so this limit is assumed"
          },
          {
            "id": "mos_lv_vds_max",
            "class": "mos_lv",
            "quantity": "vds",
            "op": "<=",
            "limit": 1.6,
            "source": "ihp-sg13g2/libs.tech/ngspice/models/sg13g2_moslv_parm.lib (VDS_MAX = 1.6)"
          },
          {
            "id": "mos_lv_vgs_max",
            "class": "mos_lv",
            "quantity": "vgs",
            "op": "<=",
            "limit": 1.6,
            "source": "ihp-sg13g2/libs.tech/ngspice/models/sg13g2_moslv_parm.lib (VGS_MAX = 1.6)"
          },
          {
            "id": "mos_hv_vds_max",
            "class": "mos_hv",
            "quantity": "vds",
            "op": "<=",
            "limit": 3.0,
            "source": "ihp-sg13g2/libs.tech/ngspice/models/sg13g2_moshv_parm.lib (VDS_MAX = 3.0)"
          },
          {
            "id": "mos_hv_vgs_max",
            "class": "mos_hv",
            "quantity": "vgs",
            "op": "<=",
            "limit": 3.0,
            "source": "ihp-sg13g2/libs.tech/ngspice/models/sg13g2_moshv_parm.lib (VGS_MAX = 3.0)"
          }
        ]
      }
    },
    "passives": {
      "ihp-sg13g2": {
        "r": {
          "device": "rhigh",
          "sheet_ohm": 1360,
          "width_min_m": 5e-07,
          "source": "ihp-sg13g2/libs.doc/doc/SG13G2_os_process_spec.pdf (2.9 Rhigh: sheet resistance 1360 ohm/sq target); ihp-sg13g2/libs.tech/ngspice/models/cornerRES.lib (rsh_rhigh = 1360); ihp-sg13g2/libs.doc/doc/SG13G2_os_layout_rules.pdf (6.4 Rhi.a: min. GatPoly width 0.50 um)"
        },
        "c": {
          "device": "cap_cmim",
          "density_f_per_m2": 0.0015,
          "source": "ihp-sg13g2/libs.doc/doc/SG13G2_os_process_spec.pdf (2.12 MIM capacitor: 1.5 fF/um2 target); ihp-sg13g2/libs.tech/ngspice/models/cornerCAP.lib (cap_carea = 1.5E-15)"
        }
      },
      "ihp-sg13cmos5l": {
        "r": {
          "device": "rhigh",
          "sheet_ohm": 1360,
          "width_min_m": 5e-07,
          "source": "ihp-sg13cmos5l/libs.doc/doc/SG13CMOS5L_os_process_spec.pdf (2.2.3 Rhigh: sheet resistance 1360 ohm/sq target); ihp-sg13cmos5l/libs.tech/ngspice/models/cornerRES.lib (rsh_rhigh = 1360); ihp-sg13cmos5l/libs.doc/doc/SG13CMOS5L_os_layout_rules.pdf (6.3 Rhi.a: min. GatPoly width 0.50 um)"
        },
        "c": {
          "device": "cap_cmomf",
          "density_f_per_m2": 0.001287,
          "source": "ihp-sg13cmos5l/libs.tech/klayout/tech/drc/docs/precheck_rules.md (CMOS5L.FORB.MIM: the MIM layer is prohibited, so the densest capacitor is a MOM capacitor); ihp-sg13cmos5l/libs.tech/ngspice/models/cap_cmomf.lib (areacap = 0.372 + (mmax - mmin) x 0.305 fF/um2; Metal1 to Metal4: 1.287 fF/um2; a simulation-derived estimate, not silicon data)"
        }
      }
    },
    "devices": {
      "sg13_lv_nmos": {
        "kind": "nmos",
        "terminals": ["d", "g", "s", "b"],
        "params": {
          "w": {
            "role": "width",
            "required": true,
            "size": true,
            "min": 1.5e-07,
            "per_finger": true,
            "source": "ihp-sg13g2/libs.tech/ngspice/models/sg13g2_moslv_mod.lib (w/ng >= 0.15u, wmin=0.15e-6); ihp-sg13g2/libs.tech/klayout/tech/drc/docs/main_rules.md (Act.a 0.15 um)"
          },
          "l": {
            "role": "length",
            "required": true,
            "size": true,
            "min": 1.3e-07,
            "source": "ihp-sg13g2/libs.tech/klayout/tech/drc/docs/main_rules.md (Gat.a1 0.13 um, 1.2 V NFET)"
          },
          "ng": {
            "role": "fingers",
            "integer": true,
            "min": 1,
            "source": "ihp-sg13g2/libs.tech/ngspice/models/sg13g2_moslv_mod.lib (ng is passed to the device as nf)"
          },
          "m": {
            "role": "multiplier",
            "integer": true,
            "min": 1,
            "source": "ihp-sg13g2/libs.tech/ngspice/models/sg13g2_moslv_mod.lib (m is passed to the device as mult)"
          }
        },
        "width_total": true,
        "source": "ihp-sg13g2/libs.tech/ngspice/models/sg13g2_moslv_mod.lib"
      },
      "sg13_lv_pmos": {
        "kind": "pmos",
        "terminals": ["d", "g", "s", "b"],
        "params": {
          "w": {
            "role": "width",
            "required": true,
            "size": true,
            "min": 1.5e-07,
            "per_finger": true,
            "source": "ihp-sg13g2/libs.tech/ngspice/models/sg13g2_moslv_mod.lib (w/ng >= 0.15u, wmin=0.15e-6); ihp-sg13g2/libs.tech/klayout/tech/drc/docs/main_rules.md (Act.a 0.15 um)"
          },
          "l": {
            "role": "length",
            "required": true,
            "size": true,
            "min": 1.3e-07,
            "source": "ihp-sg13g2/libs.tech/klayout/tech/drc/docs/main_rules.md (Gat.a2 0.13 um, 1.2 V PFET)"
          },
          "ng": {
            "role": "fingers",
            "integer": true,
            "min": 1,
            "source": "ihp-sg13g2/libs.tech/ngspice/models/sg13g2_moslv_mod.lib (ng is passed to the device as nf)"
          },
          "m": {
            "role": "multiplier",
            "integer": true,
            "min": 1,
            "source": "ihp-sg13g2/libs.tech/ngspice/models/sg13g2_moslv_mod.lib (m is passed to the device as mult)"
          }
        },
        "width_total": true,
        "source": "ihp-sg13g2/libs.tech/ngspice/models/sg13g2_moslv_mod.lib"
      },
      "sg13_hv_nmos": {
        "kind": "nmos",
        "terminals": ["d", "g", "s", "b"],
        "params": {
          "w": {
            "role": "width",
            "required": true,
            "size": true,
            "min": 1.5e-07,
            "per_finger": true,
            "source": "ihp-sg13g2/libs.tech/ngspice/models/sg13g2_moshv_mod.lib (w/ng >= 0.15u, wmin=0.15e-6); ihp-sg13g2/libs.tech/klayout/tech/drc/docs/main_rules.md (Act.a 0.15 um)"
          },
          "l": {
            "role": "length",
            "required": true,
            "size": true,
            "min": 4.5e-07,
            "source": "ihp-sg13g2/libs.tech/klayout/tech/drc/docs/extra_rules.md (Gat.a3 0.45 um, 3.3 V NFET)"
          },
          "ng": {
            "role": "fingers",
            "integer": true,
            "min": 1,
            "source": "ihp-sg13g2/libs.tech/ngspice/models/sg13g2_moshv_mod.lib (ng is passed to the device as nf)"
          },
          "m": {
            "role": "multiplier",
            "integer": true,
            "min": 1,
            "source": "ihp-sg13g2/libs.tech/ngspice/models/sg13g2_moshv_mod.lib (m is passed to the device as mult)"
          }
        },
        "width_total": true,
        "source": "ihp-sg13g2/libs.tech/ngspice/models/sg13g2_moshv_mod.lib"
      },
      "sg13_hv_pmos": {
        "kind": "pmos",
        "terminals": ["d", "g", "s", "b"],
        "params": {
          "w": {
            "role": "width",
            "required": true,
            "size": true,
            "min": 1.5e-07,
            "per_finger": true,
            "source": "ihp-sg13g2/libs.tech/ngspice/models/sg13g2_moshv_mod.lib (w/ng >= 0.15u, wmin=0.15e-6); ihp-sg13g2/libs.tech/klayout/tech/drc/docs/main_rules.md (Act.a 0.15 um)"
          },
          "l": {
            "role": "length",
            "required": true,
            "size": true,
            "min": 4e-07,
            "source": "ihp-sg13g2/libs.tech/klayout/tech/drc/docs/extra_rules.md (Gat.a4 0.4 um, 3.3 V PFET)"
          },
          "ng": {
            "role": "fingers",
            "integer": true,
            "min": 1,
            "source": "ihp-sg13g2/libs.tech/ngspice/models/sg13g2_moshv_mod.lib (ng is passed to the device as nf)"
          },
          "m": {
            "role": "multiplier",
            "integer": true,
            "min": 1,
            "source": "ihp-sg13g2/libs.tech/ngspice/models/sg13g2_moshv_mod.lib (m is passed to the device as mult)"
          }
        },
        "width_total": true,
        "source": "ihp-sg13g2/libs.tech/ngspice/models/sg13g2_moshv_mod.lib"
      }
    }
  },
  "klayout": {
    "ihp-sg13g2": {
      "drc": {
        "rule_sets": {
          "main": {
            "command": ["python3", "{pdk_root}/ihp-sg13g2/libs.tech/klayout/tech/drc/run_drc.py", "--path={gds}", "--topcell={cell}", "--run_dir={run_dir}", "--disable_extra_rules", "--no_density"],
            "report": "{run_dir}/{gds_stem}_{cell}_main.lyrdb",
            "description": "the main rule table of ihp-sg13g2.drc, without the extra rules (sg13g2_maximal.drc) and the density rules (density.drc)",
            "exit_code_violations": 1,
            "incomplete_texts": ["generated an exception"],
            "default": false,
            "source": "ihp-sg13g2/libs.tech/klayout/tech/drc/run_drc.py (main runs the table main always, density.drc unless --no_density, sg13g2_maximal.drc unless --disable_extra_rules; run_check writes <layout>_<topcell>_<table>.lyrdb in --run_dir; check_drc_results returns 1 when the report has violations and 0 when it has none; run_parallel_run logs '<table> generated an exception' when a table fails); ihp-sg13g2/libs.tech/klayout/tech/drc/README.md (Usage)"
          },
          "full": {
            "command": ["python3", "{pdk_root}/ihp-sg13g2/libs.tech/klayout/tech/drc/run_drc.py", "--path={gds}", "--topcell={cell}", "--run_dir={run_dir}"],
            "report": "{run_dir}/{gds_stem}_{cell}_full.lyrdb",
            "description": "all rules of the PDK script: the main table, the extra rules (sg13g2_maximal.drc) and the density rules (density.drc)",
            "exit_code_violations": 1,
            "incomplete_texts": ["generated an exception"],
            "default": true,
            "source": "ihp-sg13g2/libs.tech/klayout/tech/drc/run_drc.py (check_drc_results merges more than one report into <layout>_<topcell>_full.lyrdb and deletes the partial reports; it returns 1 when the report has violations and 0 when it has none); ihp-sg13g2/libs.tech/klayout/tech/drc/README.md (Usage)"
          }
        }
      },
      "lvs": {
        "command": ["python3", "{pdk_root}/ihp-sg13g2/libs.tech/klayout/tech/lvs/run_lvs.py", "--layout={gds}", "--netlist={netlist}", "--topcell={cell}", "--run_dir={run_dir}"],
        "report": "{run_dir}/{gds_stem}.lvsdb",
        "extracted": "{run_dir}/{gds_stem}_extracted.cir",
        "match_text": "Congratulations! Netlists match.",
        "mismatch_text": "Netlists don't match",
        "exit_codes": { "match": [0], "mismatch": [0] },
        "netlist_format": "SPICE (.spice, .cdl or .cir) with one .subckt per cell; MOS devices as M lines with the device name of the PDK as the model, for example 'M1 d g s b sg13_lv_nmos w=1u l=0.5u ng=1 m=1'. The deck reads it with its own reader (rule_decks/custom_reader.lvs).",
        "description": "the stock LVS of the PDK script run_lvs.py (sg13g2.lvs), with schematic simplification on (the default)",
        "source": "ihp-sg13g2/libs.tech/klayout/tech/lvs/run_lvs.py (the database <layout>.lvsdb and the extracted netlist <layout>_extracted.cir in --run_dir); ihp-sg13g2/libs.tech/klayout/tech/lvs/sg13g2.lvs (it logs 'ERROR : Netlists don't match' or 'INFO : Congratulations! Netlists match.'; the script exits with 0 in both cases); ihp-sg13g2/libs.tech/klayout/tech/lvs/README.md (Usage)"
      },
      "layer_properties": {
        "path": "{pdk_root}/ihp-sg13g2/libs.tech/klayout/tech/sg13g2.lyp",
        "description": "the KLayout layer properties file of the PDK: the layer names and their layer/datatype (operations query and diff)",
        "source": "ihp-sg13g2/libs.tech/klayout/tech/sg13g2.lyp (one <properties> entry per layer: <name> in the form Metal1.drawing, <source> in the form 8/0)"
      }
    }
  },
  "device_probe": {
    "description": "One small DC deck per device class for the operation probe_devices of the ngspice and xyce adapters. Each deck has the voltage source vprobe; the probe value is its DC current. The library of a class is given per simulator; {pdk_root} is $PDK_ROOT. ngspice needs the .spiceinit of the kit (OSDI models), from SPICE_USERINIT_DIR.",
    "ihp-sg13g2": {
      "libs": {
        "mos_lv": {
          "ngspice": {
            "path": "{pdk_root}/ihp-sg13g2/libs.tech/ngspice/models/cornerMOSlv.lib",
            "section": "mos_tt"
          },
          "xyce": {
            "path": "{pdk_root}/ihp-sg13g2/libs.tech/xyce/models/cornerMOSlv.lib",
            "section": "mos_tt"
          }
        },
        "mos_hv": {
          "ngspice": {
            "path": "{pdk_root}/ihp-sg13g2/libs.tech/ngspice/models/cornerMOShv.lib",
            "section": "mos_tt"
          },
          "xyce": {
            "path": "{pdk_root}/ihp-sg13g2/libs.tech/xyce/models/cornerMOShv.lib",
            "section": "mos_tt"
          }
        },
        "hbt": {
          "ngspice": {
            "path": "{pdk_root}/ihp-sg13g2/libs.tech/ngspice/models/cornerHBT.lib",
            "section": "hbt_typ"
          },
          "xyce": {
            "path": "{pdk_root}/ihp-sg13g2/libs.tech/xyce/models/cornerHBT.lib",
            "section": "hbt_typ"
          }
        },
        "res": {
          "ngspice": {
            "path": "{pdk_root}/ihp-sg13g2/libs.tech/ngspice/models/cornerRES.lib",
            "section": "res_typ"
          },
          "xyce": {
            "path": "{pdk_root}/ihp-sg13g2/libs.tech/xyce/models/cornerRES.lib",
            "section": "res_typ"
          }
        },
        "cap": {
          "ngspice": {
            "path": "{pdk_root}/ihp-sg13g2/libs.tech/ngspice/models/cornerCAP.lib",
            "section": "cap_typ"
          },
          "xyce": {
            "path": "{pdk_root}/ihp-sg13g2/libs.tech/xyce/models/cornerCAP.lib",
            "section": "cap_typ"
          }
        },
        "dio": {
          "ngspice": {
            "path": "{pdk_root}/ihp-sg13g2/libs.tech/ngspice/models/cornerDIO.lib",
            "section": "dio_tt"
          },
          "xyce": {
            "path": "{pdk_root}/ihp-sg13g2/libs.tech/xyce/models/cornerDIO.lib",
            "section": "dio_tt"
          }
        }
      },
      "classes": {
        "mos_lv_nmos": {
          "description": "1.2 V NMOS (PSP 103)",
          "lib": "mos_lv",
          "netlist": [
            "xdut d g 0 0 sg13_lv_nmos w=1u l=0.13u",
            "vprobe d 0 0.6",
            "vg g 0 0.8"
          ],
          "source": "ihp-sg13g2/libs.tech/ngspice/models/sg13g2_moslv_mod.lib: .subckt sg13_lv_nmos d g s b"
        },
        "mos_lv_pmos": {
          "description": "1.2 V PMOS (PSP 103)",
          "lib": "mos_lv",
          "netlist": [
            "xdut d g s s sg13_lv_pmos w=1u l=0.13u",
            "vs s 0 1.2",
            "vprobe d 0 0.6",
