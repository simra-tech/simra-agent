          },
          "ng": {
            "role": "fingers",
            "integer": true,
            "min": 1,
            "source": "ihp-sg13g2/libs.tech/ngspice/models/sg13g2_moslv_mod.lib (ng is passed to the device as nf)"
          },
          "m": {
            "role": "multiplier",
