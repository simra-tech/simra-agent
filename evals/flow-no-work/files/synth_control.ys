# Synthesis of the FIR block to the IHP SG13G2 standard cells. Run from the repository root: yosys -q -s syn/synth.ys
read_verilog src/fir.v
synth -top fir
dfflibmap -liberty /foss/pdks/ihp-sg13g2/libs.ref/sg13g2_stdcell/lib/sg13g2_stdcell_typ_1p20V_25C.lib
abc -liberty /foss/pdks/ihp-sg13g2/libs.ref/sg13g2_stdcell/lib/sg13g2_stdcell_typ_1p20V_25C.lib
opt_clean
write_verilog -noattr syn/fir.nl.v
exec -- sed -i "s/ signed / /" syn/fir.nl.v
