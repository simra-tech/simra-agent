{
  "schema": "simra.requirements/0",
  "assumptions": {
    "corner_set": {
      "description": "The corner set: the HBT and MIM corners together (typ, wcs, bcs), -40 / 27 / 125 degC, VCC18 1.8 V +-5 %",
      "source": "task"
    },
    "ports_50ohm": {
      "description": "Source and load are 50 ohm in this task (in the chip the driver feeds the stage and the antenna loads it)",
      "value": 50,
      "unit": "ohm",
      "source": "task"
    },
    "drive": {
      "description": "The available input power of the stage at 122.5 GHz: +3 dBm (pin_dbm in hb.spice). The reference stage gives +3.93 dBm into 50 ohm at tt with it (sweep -12 dBm to +3 dBm: small-signal gain 2.8 dB into 50 ohm, the stage is matched for its driver, not for 50 ohm)",
      "value": 3,
      "unit": "dBm",
      "source": "task"
    },
    "vccpa": {
      "description": "VCCPA, the trimmed rail of the output stage, at its middle code",
      "value": 0.9,
      "unit": "V",
      "source": "interface specification: VCCPA 0.70 V to 1.10 V"
    },
    "iref": {
      "description": "The bias reference current of the stage, 2.2 mA from VCC18 into iref",
      "value": 0.0022,
      "unit": "A",
      "source": "interface specification, bias currents of the PA"
    },
    "ic_per_emitter_3ma": {
      "description": "Collector current at most 3 mA per emitter finger (interface specification, HBT limits; the PDK process specification gives 3.5 mA)",
      "value": 0.003,
      "unit": "A",
      "source": "interface specification, HBT limits"
    },
    "hb_harmonics_3": {
      "description": "Harmonic balance with 3 harmonics of 122.5 GHz (the EM data ends at 400 GHz)",
      "value": 3,
      "source": "task"
    },
    "temperature_method": {
      "description": "The harmonic balance runs at a global 27 C with dtemp = T - 27 on each HBT and the transit time scaled to T (temperature_method dtemp_tf of the xyce adapter): with the global temperature, Xyce fails at -40 C and 125 C on the reference stage. The MIM capacitors stay at 27 C in the harmonic balance",
      "source": "task (workaround registry xyce-sg13g2-hbt-dtemp)"
    },
    "rail_trim": {
      "description": "VCCPA is a trimmed rail; a detector loop sets it per die. The task uses 0.90 V at tt and the slow corners and 0.80 V at the fast corners (the fast HBT corner needs a lower rail to keep the peak V_CE under 1.6 V; the reference design reaches 1.65 V at 0.90 V, fast, -40 C)",
      "value": {
        "tt": 0.9,
        "slow": 0.9,
        "fast": 0.8
      },
      "unit": "V",
      "source": "interface specification (VCCPA trimmed, 0.70 V to 1.10 V) and task"
    },
    "hbt_excess_phase": {
      "description": "sw_nqs=1 on every npn13G2 instance: the excess phase of the HBT model is on in the ngspice bench, as in the Xyce model card (Xyce accepts the parameter and has the excess phase always on). The ngspice default of the PDK is sw_nqs=0.",
      "source": "task"
    }
  },
  "conditions": {
    "tt": {
      "description": "hbt, cap typ; VCC18 1.80 V; 27 degC",
      "inputs": {
        "libs": [
          {
            "path": "$PDK_ROOT/ihp-sg13g2/libs.tech/ngspice/models/cornerHBT.lib",
            "section": "hbt_typ"
          },
          {
            "path": "$PDK_ROOT/ihp-sg13g2/libs.tech/ngspice/models/cornerCAP.lib",
            "section": "cap_typ"
          }
        ],
        "params": {
          "vcc": 1.8
        },
        "temp_c": 27
      },
      "experiment_inputs": {
        "hb": {
          "libs": [
            {
              "path": "$PDK_ROOT/ihp-sg13g2/libs.tech/xyce/models/cornerHBT.lib",
              "section": "hbt_typ"
            },
            {
              "path": "$PDK_ROOT/ihp-sg13g2/libs.tech/xyce/models/cornerCAP.lib",
              "section": "cap_typ"
            }
          ]
        }
      },
      "assumptions": [
        "corner_set"
      ]
    },
    "slow_hot": {
      "description": "hbt, cap wcs; VCC18 1.71 V; 125 degC",
      "inputs": {
        "libs": [
          {
            "path": "$PDK_ROOT/ihp-sg13g2/libs.tech/ngspice/models/cornerHBT.lib",
            "section": "hbt_wcs"
          },
          {
            "path": "$PDK_ROOT/ihp-sg13g2/libs.tech/ngspice/models/cornerCAP.lib",
            "section": "cap_wcs"
          }
        ],
        "params": {
          "vcc": 1.71
        },
        "temp_c": 125
      },
      "experiment_inputs": {
        "hb": {
          "libs": [
            {
              "path": "$PDK_ROOT/ihp-sg13g2/libs.tech/xyce/models/cornerHBT.lib",
              "section": "hbt_wcs"
            },
            {
              "path": "$PDK_ROOT/ihp-sg13g2/libs.tech/xyce/models/cornerCAP.lib",
              "section": "cap_wcs"
            }
          ]
        }
      },
      "assumptions": [
        "corner_set"
      ]
    },
    "slow_cold": {
      "description": "hbt, cap wcs; VCC18 1.71 V; -40 degC",
      "inputs": {
        "libs": [
          {
            "path": "$PDK_ROOT/ihp-sg13g2/libs.tech/ngspice/models/cornerHBT.lib",
            "section": "hbt_wcs"
          },
          {
            "path": "$PDK_ROOT/ihp-sg13g2/libs.tech/ngspice/models/cornerCAP.lib",
            "section": "cap_wcs"
          }
        ],
        "params": {
          "vcc": 1.71
        },
        "temp_c": -40
      },
      "experiment_inputs": {
        "hb": {
          "libs": [
            {
              "path": "$PDK_ROOT/ihp-sg13g2/libs.tech/xyce/models/cornerHBT.lib",
              "section": "hbt_wcs"
            },
            {
              "path": "$PDK_ROOT/ihp-sg13g2/libs.tech/xyce/models/cornerCAP.lib",
              "section": "cap_wcs"
            }
          ]
        }
      },
      "assumptions": [
        "corner_set"
      ]
    },
    "fast_hot": {
      "description": "hbt, cap bcs; VCC18 1.89 V; VCCPA 0.80 V (rail trim); 125 degC",
      "inputs": {
        "libs": [
          {
            "path": "$PDK_ROOT/ihp-sg13g2/libs.tech/ngspice/models/cornerHBT.lib",
            "section": "hbt_bcs"
          },
          {
            "path": "$PDK_ROOT/ihp-sg13g2/libs.tech/ngspice/models/cornerCAP.lib",
            "section": "cap_bcs"
          }
        ],
        "params": {
          "vcc": 1.89,
          "vpa": 0.8
        },
        "temp_c": 125
      },
      "experiment_inputs": {
        "hb": {
          "libs": [
            {
              "path": "$PDK_ROOT/ihp-sg13g2/libs.tech/xyce/models/cornerHBT.lib",
              "section": "hbt_bcs"
            },
            {
              "path": "$PDK_ROOT/ihp-sg13g2/libs.tech/xyce/models/cornerCAP.lib",
              "section": "cap_bcs"
            }
          ]
        }
      },
      "assumptions": [
        "corner_set",
        "rail_trim"
      ]
    },
    "fast_cold": {
      "description": "hbt, cap bcs; VCC18 1.89 V; VCCPA 0.80 V (rail trim); -40 degC",
      "inputs": {
        "libs": [
          {
            "path": "$PDK_ROOT/ihp-sg13g2/libs.tech/ngspice/models/cornerHBT.lib",
            "section": "hbt_bcs"
          },
          {
            "path": "$PDK_ROOT/ihp-sg13g2/libs.tech/ngspice/models/cornerCAP.lib",
            "section": "cap_bcs"
          }
        ],
        "params": {
          "vcc": 1.89,
          "vpa": 0.8
        },
        "temp_c": -40
      },
      "experiment_inputs": {
        "hb": {
          "libs": [
            {
              "path": "$PDK_ROOT/ihp-sg13g2/libs.tech/xyce/models/cornerHBT.lib",
              "section": "hbt_bcs"
            },
            {
              "path": "$PDK_ROOT/ihp-sg13g2/libs.tech/xyce/models/cornerCAP.lib",
              "section": "cap_bcs"
            }
          ]
        }
      },
      "assumptions": [
        "corner_set",
        "rail_trim"
      ]
    }
  },
  "experiments": {
    "hb": {
      "adapter": "xyce",
      "operation": "hb",
      "environment": "eda",
      "assumptions": [
        "drive",
        "vccpa",
        "iref",
        "hb_harmonics_3",
        "temperature_method"
      ],
      "inputs": {
        "deck": "hb.spice",
        "tones": [
          122500000000.0
        ],
        "harmonics": 3,
        "startup_periods": 10,
        "ports": {
          "out": {
            "node": "rfout",
            "r_ohm": 50
          }
        },
        "dc_currents": [
          "vpa"
        ],
        "wall_s_per_point": 900,
        "temperature_method": "dtemp_tf"
      }
    },
    "sp": {
      "adapter": "ngspice",
      "operation": "simulate",
      "environment": "eda",
      "assumptions": [
        "vccpa",
        "iref"
      ],
      "inputs": {
        "deck": "sp.spice",
        "measurements": {
          "ipa_a": "A"
        }
      }
    }
  },
  "requirements": [
    {
      "id": "pout_tt",
      "description": "Output power at 122.5 GHz into 50 ohm at the stated drive, tt",
      "experiment": "hb",
      "measurement": "p_out_h1_dbm",
      "op": ">=",
      "limit": 3,
      "unit": "dBm",
      "conditions": [
        "tt"
      ],
      "assumptions": [
        "ports_50ohm",
        "drive"
      ],
      "limit_source": {
        "kind": "specification",
        "ref": "TXOUT row: at least +3 dBm at tt"
      }
    },
    {
      "id": "pout",
      "description": "Output power at 122.5 GHz into 50 ohm at the stated drive, every other corner",
      "experiment": "hb",
      "measurement": "p_out_h1_dbm",
      "op": ">=",
      "limit": 0,
      "unit": "dBm",
      "conditions": [
        "slow_hot",
        "slow_cold",
        "fast_hot",
        "fast_cold"
      ],
      "assumptions": [
        "ports_50ohm",
        "drive"
      ],
      "limit_source": {
        "kind": "specification",
        "ref": "TXOUT row: at least 0 dBm at every corner"
      }
    },
    {
      "id": "ipa_a",
      "description": "DC current from VCCPA under the drive",
      "experiment": "hb",
      "measurement": "i_vpa_a",
      "op": "<=",
      "limit": 0.025,
      "unit": "A",
      "conditions": [
        "tt",
        "slow_hot",
        "slow_cold",
        "fast_hot",
        "fast_cold"
      ],
      "limit_source": {
        "kind": "task",
        "ref": "25 mA from VCCPA (the PA total of the interface rows is 45 mA, driver and references included)"
      }
    },
    {
      "id": "mu",
      "description": "Stability factor mu from 1 GHz to 300 GHz, 50 ohm",
      "experiment": "sp",
      "kind": "mu",
      "stage": "pa_stage",
      "band_hz": [
        1000000000.0,
        300000000000.0
      ],
      "op": ">=",
      "limit": 1,
      "conditions": [
        "tt",
        "slow_hot",
        "slow_cold",
        "fast_hot",
        "fast_cold"
      ],
      "assumptions": [
        "ports_50ohm"
      ],
      "limit_source": {
        "kind": "specification",
        "ref": "unconditional stability 1 GHz to 300 GHz (50 ohm)"
      }
    }
  ],
  "gates": {
    "stability": {
      "stages": [
        "pa_stage"
      ],
      "conditions": [
        "tt",
        "slow_hot",
        "slow_cold",
        "fast_hot",
        "fast_cold"
      ],
      "band_hz": [
        1000000000.0,
        300000000000.0
      ]
    },
    "limits": {
      "experiments": [
        "hb"
      ],
      "technology": "ihp-sg13",
      "extra_limits": [
        {
          "id": "hbt_ic_per_emitter_3ma",
          "class": "hbt",
          "quantity": "ic_per_emitter",
          "op": "<=",
          "limit": 0.003,
          "assumption": "ic_per_emitter_3ma",
          "limit_source": {
            "kind": "specification",
            "ref": "I_C at most 3 mA per finger (the PDK process specification gives 3.5 mA)"
          }
        }
      ]
    },
    "netlist": {
      "file": "pa_stage.spice",
      "subckt": "pa_stage",
      "pins": [
        "rfin",
        "rfout",
        "vccpa",
        "vcc18",
        "iref"
      ],
      "devices": [
        "npn13G2",
        "cap_cmim"
      ],
      "wiring": {
        "r_ohm": 100,
        "l_h": 5e-11,
        "c_f": 5e-14
      },
      "couplings": true,
      "fitted": true,
      "em_passives_min": 1,
      "technology": "ihp-sg13",
      "allow_params": {
        "npn13g2": {
          "sw_nqs": [
            1
          ]
        }
      },
      "require_params": {
        "npn13g2": {
          "sw_nqs": 1
        }
      }
    },
    "device_check": {
      "ngspice_experiment": "sp",
      "xyce_experiment": "hb",
      "conditions": [
        "tt"
      ],
      "devices": [
        {
          "name": "npn13G2_nx8",
          "cell": "npn13G2",
          "params": {
            "Nx": 8
          },
          "pins": [
            "p2",
            "p1",
            "0",
            "0"
          ],
          "bias_v": [
            0.88,
            0.9
          ]
        }
      ],
      "freqs_hz": [
        122500000000.0,
        245000000000.0
      ],
      "tolerance": {
        "dc_rel": 0.02,
        "y_rel": 0.02
      }
    }
  }
}
