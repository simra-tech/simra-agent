{
  "schema": "simra.requirements/0",
  "conditions": {
    "tt": {
      "description": "tt, VDD = 1.80 V, 27 degC",
      "inputs": {
        "libs": [
          {
            "path": "$PDK_ROOT/sky130A/libs.tech/ngspice/sky130.lib.spice",
            "section": "tt"
          }
        ],
        "params": {
          "vdd": 1.8
        },
        "temp_c": 27
      }
    },
    "ss": {
      "description": "ss, VDD = 1.62 V, 125 degC",
      "inputs": {
        "libs": [
          {
            "path": "$PDK_ROOT/sky130A/libs.tech/ngspice/sky130.lib.spice",
            "section": "ss"
          }
        ],
        "params": {
          "vdd": 1.62
        },
        "temp_c": 125
      }
    },
    "ff": {
      "description": "ff, VDD = 1.98 V, -40 degC",
      "inputs": {
        "libs": [
          {
            "path": "$PDK_ROOT/sky130A/libs.tech/ngspice/sky130.lib.spice",
            "section": "ff"
          }
        ],
        "params": {
          "vdd": 1.98
        },
        "temp_c": -40
      }
    }
  },
  "experiments": {
    "design": {
      "adapter": "ngspice",
      "operation": "check_design",
      "environment": "eda",
      "inputs": {
        "file": "cmp.spice",
        "subckt": "cmp",
        "pins": [
          "inp",
          "inn",
          "out",
          "vdd",
          "vss",
          "ibias"
        ],
        "elements": [
          "mos",
          "r",
          "c"
        ],
        "devices": [
          "sky130_fd_pr__nfet_01v8",
          "sky130_fd_pr__pfet_01v8",
          "sky130_fd_pr__nfet_01v8_lvt",
          "sky130_fd_pr__pfet_01v8_lvt",
          "sky130_fd_pr__pfet_01v8_hvt"
        ],
        "limits": {
          "r_ohm": 1000000,
          "c_f": 2e-12
        },
        "technology": "sky130"
      }
    },
    "sweep": {
      "adapter": "ngspice",
      "operation": "simulate",
      "environment": "eda",
      "inputs": {
        "deck": "verify.spice",
        "measurements": {
          "tpd_r_s": "s",
          "tpd_f_s": "s",
          "voh_rel": "1",
          "vol_rel": "1",
          "vos_v": "V",
          "hyst_v": "V",
          "idd_a": "A",
          "iin_a": "A"
        }
      }
    }
  },
  "requirements": [
    {
      "id": "design_errors",
      "description": "Errors of the netlist against the design contract",
      "experiment": "design",
      "measurement": "design_errors",
      "op": "<=",
      "limit": 0
    },
    {
      "id": "area_um2",
      "description": "Area: the MOS gates plus the ideal R and C",
      "experiment": "design",
      "measurement": "area_um2",
      "unit": "um2",
      "op": "<=",
      "limit": 30
    },
    {
      "id": "tpd_r_s",
      "description": "Rise delay, Vd step from -10 mV to +10 mV, to v(out) = VDD/2",
      "experiment": "sweep",
      "measurement": "tpd_r_s",
      "unit": "s",
      "op": "<=",
      "limit": 6e-9,
      "conditions": [
        "tt",
        "ss",
        "ff"
      ]
    },
    {
      "id": "tpd_f_s",
      "description": "Fall delay, Vd step from +10 mV to -10 mV, to v(out) = VDD/2",
      "experiment": "sweep",
      "measurement": "tpd_f_s",
      "unit": "s",
      "op": "<=",
      "limit": 6e-9,
      "conditions": [
        "tt",
        "ss",
        "ff"
      ]
    },
    {
      "id": "voh_rel",
      "description": "Output high level v(out)/VDD at Vd = +10 mV",
      "experiment": "sweep",
      "measurement": "voh_rel",
      "unit": "1",
      "op": ">=",
      "limit": 0.9,
      "conditions": [
        "tt",
        "ss",
        "ff"
      ]
    },
    {
      "id": "vol_rel",
      "description": "Output low level v(out)/VDD at Vd = -10 mV",
      "experiment": "sweep",
      "measurement": "vol_rel",
      "unit": "1",
      "op": "<=",
      "limit": 0.1,
      "conditions": [
        "tt",
        "ss",
        "ff"
      ]
    },
    {
      "id": "vos_v",
      "description": "Input offset voltage, the mean of the two switching points",
      "experiment": "sweep",
      "measurement": "vos_v",
      "unit": "V",
      "op": "between",
      "limit": [
        -0.005,
        0.005
      ],
      "conditions": [
        "tt",
        "ss",
        "ff"
      ]
    },
    {
      "id": "hyst_v",
      "description": "Hysteresis, the rising minus the falling switching point",
      "experiment": "sweep",
      "measurement": "hyst_v",
      "unit": "V",
      "op": "between",
      "limit": [
        0,
        0.02
      ],
      "conditions": [
        "tt",
        "ss",
        "ff"
      ]
    },
    {
      "id": "idd_a",
      "description": "Supply current from vdd at Vd = -10 mV, with the bias current",
      "experiment": "sweep",
      "measurement": "idd_a",
      "unit": "A",
      "op": "<=",
      "limit": 0.00007,
      "conditions": [
        "tt",
        "ss",
        "ff"
      ]
    },
    {
      "id": "iin_a",
      "description": "Input current at the DC operating point with Vd = -10 mV, the larger magnitude of the current into inp and into inn",
      "experiment": "sweep",
      "measurement": "iin_a",
      "unit": "A",
      "op": "<=",
      "limit": 2e-9,
      "conditions": [
        "tt",
        "ss",
        "ff"
      ]
    }
  ]
}
