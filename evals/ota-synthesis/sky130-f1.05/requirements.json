{
  "schema": "simra.requirements/0",
  "conditions": {
    "tt": {
      "description": "tt, VDD = 1.80 V, 27 degC",
      "inputs": {
        "libs": [
          {
            "path": "$PDK_ROOT/sky130A/libs.tech/ngspice/sky130.lib.spice",
            "section": "tt"
          }
        ],
        "params": {
          "vdd": 1.8
        },
        "temp_c": 27
      }
    },
    "ss": {
      "description": "ss, VDD = 1.62 V, 125 degC",
      "inputs": {
        "libs": [
          {
            "path": "$PDK_ROOT/sky130A/libs.tech/ngspice/sky130.lib.spice",
            "section": "ss"
          }
        ],
        "params": {
          "vdd": 1.62
        },
        "temp_c": 125
      }
    },
    "ff": {
      "description": "ff, VDD = 1.98 V, -40 degC",
      "inputs": {
        "libs": [
          {
            "path": "$PDK_ROOT/sky130A/libs.tech/ngspice/sky130.lib.spice",
            "section": "ff"
          }
        ],
        "params": {
          "vdd": 1.98
        },
        "temp_c": -40
      }
    }
  },
  "experiments": {
    "design": {
      "adapter": "ngspice",
      "operation": "check_design",
      "environment": "eda",
      "inputs": {
        "file": "ota.spice",
        "subckt": "ota",
        "pins": [
          "inp",
          "inn",
          "out",
          "vdd",
          "vss",
          "ibias"
        ],
        "elements": [
          "mos",
          "r",
          "c"
        ],
        "devices": [
          "sky130_fd_pr__nfet_01v8",
          "sky130_fd_pr__pfet_01v8",
          "sky130_fd_pr__nfet_01v8_lvt",
          "sky130_fd_pr__pfet_01v8_lvt",
          "sky130_fd_pr__pfet_01v8_hvt"
        ],
        "limits": {
          "r_ohm": 1000000,
          "c_f": 2e-12
        },
        "technology": "sky130"
      }
    },
    "sweep": {
      "adapter": "ngspice",
      "operation": "simulate",
      "environment": "eda",
      "inputs": {
        "deck": "verify.spice",
        "measurements": {
          "gain_db": "dB",
          "ugf_hz": "Hz",
          "pm_deg": "deg",
          "idd_a": "A",
          "iin_a": "A"
        }
      }
    }
  },
  "requirements": [
    {
      "id": "design_errors",
      "description": "Errors of the netlist against the design contract",
      "experiment": "design",
      "measurement": "design_errors",
      "op": "<=",
      "limit": 0
    },
    {
      "id": "area_um2",
      "description": "Area: the MOS gates plus the ideal R and C",
      "experiment": "design",
      "measurement": "area_um2",
      "unit": "um2",
      "op": "<=",
      "limit": 587
    },
    {
      "id": "gain_db",
      "description": "DC open-loop gain, at 1 Hz",
      "experiment": "sweep",
      "measurement": "gain_db",
      "unit": "dB",
      "op": ">=",
      "limit": 65,
      "conditions": [
        "tt",
        "ss",
        "ff"
      ]
    },
    {
      "id": "ugf_hz",
      "description": "Unity-gain frequency",
      "experiment": "sweep",
      "measurement": "ugf_hz",
      "unit": "Hz",
      "op": ">=",
      "limit": 16500000,
      "conditions": [
        "tt",
        "ss",
        "ff"
      ]
    },
    {
      "id": "pm_deg",
      "description": "Phase margin",
      "experiment": "sweep",
      "measurement": "pm_deg",
      "unit": "deg",
      "op": ">=",
      "limit": 60,
      "conditions": [
        "tt",
        "ss",
        "ff"
      ]
    },
    {
      "id": "idd_a",
      "description": "Supply current, into vdd",
      "experiment": "sweep",
      "measurement": "idd_a",
      "unit": "A",
      "op": "<=",
      "limit": 0.000079,
      "conditions": [
        "tt",
        "ss",
        "ff"
      ]
    },
    {
      "id": "iin_a",
      "description": "Input current, the larger magnitude of the DC current into inp and into inn",
      "experiment": "sweep",
      "measurement": "iin_a",
      "unit": "A",
      "op": "<=",
      "limit": 2e-9,
      "conditions": [
        "tt",
        "ss",
        "ff"
      ]
    }
  ]
}
